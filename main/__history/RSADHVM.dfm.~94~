    Caption = 'How To Use'
    TabOrder = 5
    Visible = False
    object RichEdit1: TRichEdit
      Left = 2
      Top = 23
      Width = 1150
      Height = 562
      Align = alClient
      Color = clBtnFace
      Font.Charset = ANSI_CHARSET
      Font.Color = clWindowText
      Font.Height = -16
      Font.Name = 'Segoe UI'
      Font.Style = [fsBold]
      Lines.Strings = (
        '1. Enter Keys'
        
          '    - In the "Encryption Input Key" section, enter the required ' +
          'numerical keys (p1, p2, q1, q2, x, y).'
        
          '    - Enter the text key for the Vigenere cipher in the "Vigener' +
          'e Key (Vs)" field.'
        '    Note: p1, p2, q1, q2, x, y numbers only.'
        '2. Load Input Image'
        '    - Click the "Browse" button in the "Input Image" section.'
        '    - Select the image file you want to encrypt.'
        '    The image should appear in the "Input Image" display area.'
        '3. Encrypt the Image'
        '    - Click the "Encrypt" button.'
        
          '    The program will perform the RSA-Diffie-Hellman and Vigenere' +
          '-Multiplicative cipher encryption using the entered keys.'
        '4. View Encrypted Image'
        
          '    The encrypted image will be displayed in the "Output Image" ' +
          'area.'
        '5. Save Encrypted Image'
        '    - Click the "Save" button in the "Output Image" section.'
        
          '    - Choose a location and filename to save the encrypted image' +
          '.'
        ''
        'Optional: '
        '1. Save Keys'
        
          '    - Click the "Save Input Key to txt file" button to save the ' +
          'keys to a text file.'
        '2. Save Calculation Result'
        
          '    - Click the "Save" button in calculation section to save the' +
          ' calculation results to a text file.'
        ''
        'Reset:'
        ' - Use the "Reset" buttons to clear the input or output image.'
        ' - Use the "Reset Key" button to clear the entered keys.'
        ' - Use the "Reset All" button to clear everything.')
      ParentFont = False
      PlainText = True
      ReadOnly = True
      ScrollBars = ssBoth
      TabOrder = 0
    end
  end
