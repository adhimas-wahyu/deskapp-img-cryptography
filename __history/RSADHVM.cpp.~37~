void __fastcall TForm_Main::SpeedButton1Click(TObject *Sender)
{
	time_t now = time(nullptr);
	tm* timeinfo = localtime(&now);

	stringstream filename;
	filename << "InputKeyFile_"
			 << setfill('0') << std::setw(4) << (timeinfo->tm_year + 1900) << "-"
			 << setw(2) << (timeinfo->tm_mon + 1) << "-"
			 << setw(2) << timeinfo->tm_mday << "_"
			 << setw(2) << timeinfo->tm_hour << "-"
			 << setw(2) << timeinfo->tm_min << "-"
			 << setw(2) << timeinfo->tm_sec << ".txt";

	ofstream keyFile(filename.str().c_str());

	if (keyFile.is_open()) {
		keyFile << "===== Input Key =====" << endl;
		keyFile << "p1 = " << Edit_p1->Text.c_str() << endl;
		keyFile << "p2 = " << Edit_p2->Text.c_str() << endl;
		keyFile << "q1 = " << Edit_q1->Text.c_str() << endl;
		keyFile << "q2 = " << Edit_q2->Text.c_str() << endl;
		keyFile << "Vigenere Key = " << Edit_VigenereKey->Text.c_str() << endl;
		keyFile.close();

		ShowMessage("Data saved to " + filename.str());
	} else {
		ShowMessage("Error opening file!");
	}
}
